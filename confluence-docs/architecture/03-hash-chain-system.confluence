{panel}

## Monitoring and Alerting

### Chain Health Monitoring

{expand:title=Continuous Chain Monitoring}
{code:sql|title=Chain Health Monitoring Queries}
-- Daily chain verification for all blockchain tables
SELECT 
    table_name,
    COUNT(*) as total_rows,
    COUNT(*) FILTER (WHERE hash_valid = true) as valid_rows,
    COUNT(*) FILTER (WHERE hash_valid = false) as invalid_rows
FROM (
    SELECT 'audit_log' as table_name, * FROM verify_hash_chain('audit_log')
    UNION ALL
    SELECT 'transaction_log' as table_name, * FROM verify_hash_chain('transaction_log')
    -- Add all blockchain tables
) verification_results
GROUP BY table_name;

-- Alert on chain integrity failures
CREATE OR REPLACE FUNCTION check_chain_integrity()
RETURNS BOOLEAN AS $$
DECLARE
    table_record RECORD;
    invalid_count INTEGER;
BEGIN
    FOR table_record IN SELECT * FROM list_blockchain_tables() LOOP
        SELECT COUNT(*) INTO invalid_count
        FROM verify_hash_chain(table_record.table_name)
        WHERE hash_valid = false;
        
        IF invalid_count > 0 THEN
            RAISE WARNING 'Chain integrity failure in table %: % invalid hashes',
                         table_record.table_name, invalid_count;
            RETURN FALSE;
        END IF;
    END LOOP;
    
    RETURN TRUE;
END;
$$ LANGUAGE plpgsql;
{code}
{expand}

