## Hash Chain APIs

### Hash Computation Functions

{expand:title=Core Hash Functions}
{code:c|title=Hash Computation}
/**
 * Compute SHA-256 hash for a blockchain table row with counter
 * 
 * @param rel The blockchain table relation
 * @param slot Tuple slot containing the row data
 * @param ts Timestamp to include in hash
 * @param prev_hash Hash of the previous row (NULL for first row)
 * @param counter Global counter value for this row
 * @return bytea containing the computed SHA-256 hash
 */
bytea *compute_curr_hash_with_counter(Relation rel, TupleTableSlot *slot,
                                     TimestampTz ts, bytea *prev_hash, 
                                     uint64 counter);

/**
 * Get the hash of the most recent row in a blockchain table
 * 
 * @param rel The blockchain table relation
 * @return bytea containing the previous hash, or NULL if table is empty
 */
bytea *get_previous_hash(Relation rel);

/**
 * Verify that a computed hash matches the stored hash for a row
 * 
 * @param rel The blockchain table relation
 * @param slot Tuple slot containing the row data
 * @param expected_hash The hash that should match
 * @return true if hashes match, false otherwise
 */
bool verify_row_hash(Relation rel, TupleTableSlot *slot, bytea *expected_hash);

/**
 * Extract the current hash from a heap tuple
 * 
 * @param tuple The heap tuple
 * @param rel The blockchain table relation
 * @return bytea containing the current hash
 */
bytea *extract_current_hash_from_tuple(HeapTuple tuple, Relation rel);
{code}
{expand}

### Data Serialization

{expand:title=Hash Data Serialization Functions}
{code:c|title=Data Serialization}
/**
 * Serialize a datum to a deterministic string representation for hashing
 * 
 * @param value The datum to serialize
 * @param typeid The PostgreSQL type OID
 * @return Allocated string representation (caller must pfree)
 */
char *serialize_datum_deterministic(Datum value, Oid typeid);

/**
 * Serialize all user columns from a tuple slot for hash computation
 * 
 * @param slot The tuple slot
 * @param rel The relation (for column information)
 * @return Allocated string representation (caller must pfree)
 */
char *serialize_user_columns_for_hash(TupleTableSlot *slot, Relation rel);

/**
 * Create a canonical string representation of a timestamp for hashing
 * 
 * @param ts The timestamp value
 * @return Allocated string representation (caller must pfree)
 */
char *serialize_timestamp_for_hash(TimestampTz ts);

/**
 * Create a canonical string representation of a counter for hashing
 * 
 * @param counter The counter value
 * @return Allocated string representation (caller must pfree)
 */
char *serialize_counter_for_hash(uint64 counter);
{code}
{expand}

### Chain Verification

{expand:title=Chain Verification Functions}
{code:c|title=Chain Verification}
/**
 * Verify the entire hash chain for a blockchain table
 * 
 * @param rel The blockchain table relation
 * @param error_callback Function to call for each verification error
 * @param callback_context Context data for error callback
 * @return true if entire chain is valid, false if any errors found
 */
bool verify_complete_hash_chain(Relation rel, 
                               void (*error_callback)(uint64 counter, 
                                                     const char *error_msg,
                                                     void *context),
                               void *callback_context);

/**
 * Verify hash chain integrity for a specific range of rows
 * 
 * @param rel The blockchain table relation
 * @param start_counter Starting counter value (inclusive)
 * @param end_counter Ending counter value (inclusive)
 * @return Number of verification errors found
 */
int verify_hash_chain_range(Relation rel, uint64 start_counter, uint64 end_counter);

/**
 * Get detailed information about a specific link in the hash chain
 * 
 * @param rel The blockchain table relation
 * @param counter The counter value to examine
 * @param info Structure to fill with chain information
 * @return true if counter exists and info was filled, false otherwise
 */
bool get_hash_chain_link_info(Relation rel, uint64 counter, 
                             BlockchainChainLinkInfo *info);
{code}
{expand}

## Counter Management APIs

### Core Counter Functions

{expand:title=Counter Operations}
{code:c|title=Counter Management}
/**
 * Get the next counter value for a blockchain table
 * 
 * @param table_oid OID of the blockchain table
 * @return Next unique counter value
 */
uint64 BlockchainGetNextCounter(Oid table_oid);

/**
 * Get the current global counter value (without incrementing)
 * 
 * @return Current global counter value
 */
uint64 BlockchainGetCurrentCounter(void);

/**
 * Preview what the next counter value would be for a table
 * 
 * @param table_oid OID of the blockchain table
 * @return Next counter value that would be assigned
 */
uint64 BlockchainPreviewNextCounter(Oid table_oid);

/**
 * Force persistence of current counter state to disk
 * 
 * @return true if persistence successful, false otherwise
 */
bool BlockchainPersistCounters(void);

/**
 * Trigger recovery for a specific table's counter state
 * 
 * @param table_oid OID of the blockchain table
 * @return true if recovery completed successfully
 */
bool BlockchainRecoverTableCounter(Oid table_oid);
{code}
{expand}

### Shared Memory Management

{expand:title=Counter Shared Memory Functions}
{code:c|title=Shared Memory Management}
/**
 * Initialize the blockchain counter shared memory segment
 * Called during PostgreSQL startup
 */
void BlockchainCounterShmemInit(void);

/**
 * Calculate the required size for counter shared memory
 * 
 * @return Size in bytes required for shared memory
 */
Size BlockchainCounterShmemSize(void);

/**
 * Get statistics about counter shared memory usage
 * 
 * @param stats Structure to fill with statistics
 */
void BlockchainGetCounterStats(BlockchainCounterStats *stats);

/**
 * Register a new blockchain table with the counter system
 * 
 * @param table_oid OID of the blockchain table
 * @param table_name Name of the table (for debugging)
 * @return Index of the table in the counter array, or -1 if full
 */
int BlockchainRegisterTable(Oid table_oid, const char *table_name);

/**
 * Unregister a blockchain table from the counter system
 * 
 * @param table_oid OID of the blockchain table
 */
void BlockchainUnregisterTable(Oid table_oid);
{code}
{expand}

### Counter Recovery

{expand:title=Recovery Functions}
{code:c|title=Counter Recovery}
/**
 * Perform lazy recovery for all tables that need it
 * 
 * @return Number of tables that required recovery
 */
int BlockchainPerformLazyRecovery(void);

/**
 * Scan a blockchain table to determine its maximum counter value
 * 
 * @param rel The blockchain table relation
 * @return Maximum counter value found, or 0 if table is empty
 */
uint64 BlockchainScanTableForMaxCounter(Relation rel);

/**
 * Load counter state from persistent storage
