## Data Structures

### Core Structures

{expand:title=Key Data Structures}
{code:c|title=Data Structure Definitions}
/**
 * System column definition structure
 */
typedef struct BlockchainColumnDef
{
    const char *colname;        // Column name (e.g., "__curr_hash")
    Oid typeid;                 // PostgreSQL type OID
    int32 typmod;               // Type modifier
    int attnum;                 // Attribute number in relation
    bool is_hidden;             // Hidden from SELECT * queries
    const char *description;    // Human-readable description
} BlockchainColumnDef;

/**
 * System column values extracted from a tuple
 */
typedef struct BlockchainSystemColumnValues
{
    Datum row_id;               // __row_id (UUID)
    Datum curr_hash;            // __curr_hash (bytea)
    Datum prev_hash;            // __prev_hash (bytea)
    Datum tx_type;              // __tx_type (text)
    Datum tx_lsn;               // __tx_lsn (bigint)
    Datum tx_origin;            // __tx_origin (UUID)
    Datum tx_version;           // __tx_version (int4)
    Datum is_latest;            // __is_latest (bool)
    Datum tx_timestamp;         // __tx_timestamp (timestamptz)
    
    bool row_id_isnull;         // Null flags for each column
    bool curr_hash_isnull;
    bool prev_hash_isnull;
    bool tx_type_isnull;
    bool tx_lsn_isnull;
    bool tx_origin_isnull;
    bool tx_version_isnull;
    bool is_latest_isnull;
    bool tx_timestamp_isnull;
} BlockchainSystemColumnValues;

/**
 * Hash chain link information
 */
typedef struct BlockchainChainLinkInfo
{
    uint64 counter;             // Counter value for this link
    bytea *curr_hash;           // Current hash
    bytea *prev_hash;           // Previous hash
    TimestampTz timestamp;      // Timestamp when row was created
    bool hash_valid;            // Whether the hash is valid
    char *error_message;        // Error message if hash is invalid
} BlockchainChainLinkInfo;

/**
 * Counter system statistics
 */
typedef struct BlockchainCounterStats
{
    uint64 global_counter;      // Current global counter value
    int num_tables;             // Number of registered tables
    Size shared_mem_size;       // Size of shared memory used
    TimestampTz last_persist;   // Last persistence timestamp
    int pending_recoveries;     // Number of tables needing recovery
    uint64 total_increments;    // Total counter increments since startup
} BlockchainCounterStats;
{code}
{expand}

### Constants and Macros

{expand:title=Constants and Utility Macros}
{code:c|title=Constants and Macros}
/* Relation kind for blockchain tables */
#define RELKIND_BLOCKCHAIN_TABLE 'b'

/* Maximum number of blockchain tables (configurable) */
#define MAX_BLOCKCHAIN_TABLES 1000

/* System column name prefixes */
#define BLOCKCHAIN_SYSTEM_COLUMN_PREFIX "__"

/* Hash digest length for SHA-256 */
#define BLOCKCHAIN_HASH_LENGTH SHA256_DIGEST_LENGTH

/* Counter file name */
#define BLOCKCHAIN_COUNTER_FILENAME "blockchain_counter.dat"

/* System column names */
#define BLOCKCHAIN_ROW_ID_COLNAME "__row_id"
#define BLOCKCHAIN_CURR_HASH_COLNAME "__curr_hash"
#define BLOCKCHAIN_PREV_HASH_COLNAME "__prev_hash"
#define BLOCKCHAIN_TX_TYPE_COLNAME "__tx_type"
#define BLOCKCHAIN_TX_LSN_COLNAME "__tx_lsn"
#define BLOCKCHAIN_TX_ORIGIN_COLNAME "__tx_origin"
#define BLOCKCHAIN_TX_VERSION_COLNAME "__tx_version"
#define BLOCKCHAIN_IS_LATEST_COLNAME "__is_latest"
#define BLOCKCHAIN_TX_TIMESTAMP_COLNAME "__tx_timestamp"

/* Utility macros */
#define IsBlockchainSystemColumn(colname) \
    (strncmp((colname), BLOCKCHAIN_SYSTEM_COLUMN_PREFIX, 2) == 0)

#define BlockchainTableOidIsValid(oid) \
    (OidIsValid(oid) && is_blockchain_table_oid(oid))

/* Error context helper */
#define BLOCKCHAIN_ERROR_CONTEXT_INIT(callback_func, context_data) \
    do { \
        ErrorContextCallback error_context; \
        error_context.callback = (callback_func); \
        error_context.arg = (context_data); \
        error_context.previous = error_context_stack; \
        error_context_stack = &error_context;
        
#define BLOCKCHAIN_ERROR_CONTEXT_END() \
        error_context_stack = error_context.previous; \
    } while(0)
{code}
{expand}

## Integration Examples

### Extension Development Example

{expand:title=Complete Extension Example}
{code:c|title=Sample Blockchain Extension}
#include "postgres.h"
#include "fmgr.h"
#include "blockchain/blockchainam.h"
#include "blockchain/blockchain_hash.h"
#include "blockchain/blockchain_counter.h"

PG_MODULE_MAGIC;

/* Function to get blockchain table information */
PG_FUNCTION_INFO_V1(get_blockchain_table_info);

Datum
get_blockchain_table_info(PG_FUNCTION_ARGS)
{
    Oid table_oid = PG_GETARG_OID(0);
    Relation rel;
    TupleDesc tupdesc;
    Datum values[4];
    bool nulls[4] = {false, false, false, false};
    HeapTuple tuple;
    
    /* Verify this is a blockchain table */
    if (!is_blockchain_table_oid(table_oid))
    {
        ereport(ERROR,
                (errcode(ERRCODE_WRONG_OBJECT_TYPE),
                 errmsg("relation %u is not a blockchain table", table_oid)));
    }
    
    /* Open the relation */
    rel = relation_open(table_oid, AccessShareLock);
    
    /* Build result tuple descriptor */
    tupdesc = CreateTemplateTupleDesc(4);
    TupleDescInitEntry(tupdesc, (AttrNumber) 1, "table_name", TEXTOID, -1, 0);
    TupleDescInitEntry(tupdesc, (AttrNumber) 2, "row_count", INT8OID, -1, 0);
    TupleDescInitEntry(tupdesc, (AttrNumber) 3, "max_counter", INT8OID, -1, 0);
    TupleDescInitEntry(tupdesc, (AttrNumber) 4, "chain_valid", BOOLOID, -1, 0);
    
    /* Get table information */
    values[0] = CStringGetTextDatum(RelationGetRelationName(rel));
    values[1] = Int64GetDatum(get_table_row_count(rel));
    values[2] = Int64GetDatum(BlockchainScanTableForMaxCounter(rel));
    values[3] = BoolGetDatum(verify_complete_hash_chain(rel, NULL, NULL));
    
    /* Create and return tuple */
    tuple = heap_form_tuple(tupdesc, values, nulls);
    
    relation_close(rel, AccessShareLock);
    
    PG_RETURN_DATUM(HeapTupleGetDatum(tuple));
}

/* Helper function to count rows in a table */
static int64
get_table_row_count(Relation rel)
{
    TableScanDesc scan;
    TupleTableSlot *slot;
    int64 count = 0;
    
    scan = blockchain_scan_begin(rel, GetActiveSnapshot(), 0, NULL, NULL, 0);
    slot = MakeSingleTupleTableSlot(RelationGetDescr(rel), &TTSOpsHeapTuple);
    
    while (blockchain_scan_getnextslot(scan, ForwardScanDirection, slot))
    {
        count++;
        ExecClearTuple(slot);
    }
    
    ExecDropSingleTupleTableSlot(slot);
    blockchain_scan_end(scan);
    
    return count;
}
{code}
{expand}

### TAM Integration Example

{expand:title=Custom TAM Function Example}
{code:c|title=Custom TAM Function}
/* Example of creating a custom function that works with blockchain TAM */
PG_FUNCTION_INFO_V1(verify_table_hash_chain);

Datum
verify_table_hash_chain(PG_FUNCTION_ARGS)
{
    text *table_name_text = PG_GETARG_TEXT_PP(0);
    char *table_name = text_to_cstring(table_name_text);
    Oid table_oid;
    Relation rel;
    bool chain_valid;
    int error_count = 0;
    
    /* Convert table name to OID and verify it's a blockchain table */
    table_oid = get_blockchain_table_oid_by_name(table_name);
    
    /* Open the relation */
    rel = relation_open(table_oid, AccessShareLock);
    
    /* Set up error context */
    BLOCKCHAIN_ERROR_CONTEXT_INIT(hash_verification_error_context, &error_count);
    
    /* Verify the hash chain */
    chain_valid = verify_complete_hash_chain(rel, count_verification_errors, &error_count);
    
    BLOCKCHAIN_ERROR_CONTEXT_END();
    
    relation_close(rel, AccessShareLock);
    
    /* Return result */
    if (chain_valid && error_count == 0)
        PG_RETURN_BOOL(true);
    else
        PG_RETURN_BOOL(false);
}

/* Error counting callback for hash verification */
static void
count_verification_errors(uint64 counter, const char *error_msg, void *context)
{
    int *error_count = (int *) context;
    (*error_count)++;
    
    elog(WARNING, "Hash chain error at counter %lu: %s", counter, error_msg);
}

/* Error context callback */
static void
hash_verification_error_context(void *arg)
{
    int *error_count = (int *) arg;
    errcontext("blockchain hash chain verification, %d errors found", *error_count);
}
{code}
{expand}

## Performance Considerations

### API Performance Guidelines

{tip:title=Performance Best Practices}
**High-Performance APIs (< 1µs):**
* `is_blockchain_table_oid()` - Cached table type checks
* `BlockchainGetCurrentCounter()` - Read-only counter access
* `is_blockchain_system_column()` - String comparison only

**Medium-Performance APIs (1-10µs):**
* `BlockchainGetNextCounter()` - Shared memory increment
* `compute_curr_hash_with_counter()` - SHA-256 computation
* System column population functions

**Lower-Performance APIs (10µs+):**
* `verify_complete_hash_chain()` - Full table verification
* `BlockchainScanTableForMaxCounter()` - Full table scan
* Recovery functions
{tip}

### Memory Management

{panel:title=Memory Usage Guidelines|borderColor=#FF9800|titleBGColor=#FFF3E0}
**Allocation Patterns:**
* Use appropriate PostgreSQL memory contexts
* Free temporary allocations promptly
* Avoid memory leaks in error paths

**Shared Memory:**
* Counter system uses fixed allocation
* No dynamic shared memory allocation
* Efficient lock usage patterns

**Performance Tips:**
* Cache frequently accessed data
* Minimize memory copying
* Use stack allocation for small buffers
{panel}

