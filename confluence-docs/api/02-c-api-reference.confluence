## System Column APIs

### Column Definition Functions

{expand:title=System Column Management}
{code:c|title=System Column Operations}
/**
 * Check if a column name is a blockchain system column
 * 
 * @param colname The column name to check
 * @return true if it's a system column, false otherwise
 */
bool is_blockchain_system_column(const char *colname);

/**
 * Get the number of system columns in blockchain tables
 * 
 * @return Number of system columns (currently 9)
 */
int get_blockchain_system_column_count(void);

/**
 * Get definition information for a specific system column
 * 
 * @param index Index of the system column (0-based)
 * @param coldef Structure to fill with column definition
 * @return true if index is valid, false otherwise
 */
bool get_blockchain_system_column_def(int index, BlockchainColumnDef *coldef);

/**
 * Get the attribute number for a system column in a relation
 * 
 * @param rel The blockchain table relation
 * @param colname Name of the system column
 * @return Attribute number, or InvalidAttrNumber if not found
 */
AttrNumber get_system_column_attno(Relation rel, const char *colname);
{code}
{expand}

### System Column Population

{expand:title=System Column Data Management}
{code:c|title=System Column Population}
/**
 * Populate all system columns in a tuple slot for INSERT
 * 
 * @param slot The tuple slot to populate
 * @param rel The blockchain table relation
 * @param counter The counter value for this row
 * @param prev_hash Hash of the previous row
 * @param curr_hash Hash of the current row
 */
void populate_blockchain_system_columns(TupleTableSlot *slot, Relation rel,
                                       uint64 counter, bytea *prev_hash,
                                       bytea *curr_hash);

/**
 * Extract system column values from a stored tuple
 * 
 * @param tuple The heap tuple
 * @param rel The blockchain table relation
 * @param values Structure to fill with system column values
 */
void extract_system_column_values(HeapTuple tuple, Relation rel,
                                 BlockchainSystemColumnValues *values);

/**
 * Validate that system columns are not specified in an INSERT
 * 
 * @param slot The tuple slot for INSERT
 * @param rel The blockchain table relation
 * @throws Error if any system columns are specified by user
 */
void validate_user_insert_columns(TupleTableSlot *slot, Relation rel);

/**
 * Filter system columns from SELECT * results
 * 
 * @param slot The tuple slot to filter
 * @param show_system_columns Whether to show system columns
 */
void filter_system_columns_from_result(TupleTableSlot *slot, 
                                      bool show_system_columns);
