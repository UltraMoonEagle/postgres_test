## Table Access Method APIs

### Core TAM Functions

{expand:title=Primary TAM Interface Functions}
{code:c|title=GetBlockchainTableAmRoutine}
/**
 * Returns the blockchain table access method routine structure
 * 
 * @return Pointer to TableAmRoutine structure with blockchain TAM methods
 */
const TableAmRoutine *GetBlockchainTableAmRoutine(void);

/**
 * Usage Example:
 */
Datum
blockchain_am_handler(PG_FUNCTION_ARGS)
{
    PG_RETURN_POINTER(GetBlockchainTableAmRoutine());
}
{code}
{expand}

### Tuple Operations

{expand:title=Tuple Management Functions}
{code:c|title=Tuple Operations}
/**
 * Insert a new tuple into a blockchain table
 * 
 * @param relation The blockchain table relation
 * @param slot The tuple slot containing data to insert
 * @param cid Command ID for the operation
 * @param options Insert options (flags)
 * @param bistate Bulk insert state (can be NULL)
 */
static void blockchain_tuple_insert(Relation relation, TupleTableSlot *slot,
                                   CommandId cid, int options, 
                                   BulkInsertState bistate);

/**
 * Lock a tuple for read access
 * 
 * @param relation The blockchain table relation
 * @param tid Item pointer to the tuple
 * @param snapshot Snapshot for visibility
 * @param slot Slot to store the tuple data
 * @param cid Command ID
 * @param mode Lock mode (always ShareLock for blockchain)
 * @param wait_policy Wait policy for lock acquisition
 * @param flags Additional flags
 * @param tmfd Failure data structure
 * @return TM_Result indicating success or failure
 */
static TM_Result blockchain_tuple_lock(Relation relation, ItemPointer tid,
                                      Snapshot snapshot, TupleTableSlot *slot,
                                      CommandId cid, LockTupleMode mode,
                                      LockWaitPolicy wait_policy, uint8 flags,
                                      TM_FailureData *tmfd);

/**
 * Note: UPDATE and DELETE operations return NULL function pointers
 * to ensure immutability at the TAM level
 */
{code}
{expand}

### Scan Operations

{expand:title=Table Scanning Functions}
{code:c|title=Scan Management}
/**
 * Begin a sequential scan of a blockchain table
 * 
 * @param relation The blockchain table to scan
 * @param snapshot Snapshot for visibility
 * @param nkeys Number of scan keys (usually 0 for full scan)
 * @param key Scan keys for filtering (can be NULL)
 * @param parallel_scan Parallel scan information (can be NULL)
 * @param flags Scan flags
 * @return TableScanDesc for the scan
 */
static TableScanDesc blockchain_scan_begin(Relation relation, Snapshot snapshot,
                                          int nkeys, ScanKey key,
                                          ParallelTableScanDesc parallel_scan,
                                          uint32 flags);

/**
 * Get the next tuple from a blockchain table scan
 * 
 * @param scan The table scan descriptor
 * @param direction Scan direction (usually ForwardScanDirection)
 * @param slot Slot to store the retrieved tuple
 * @return Slot with tuple data, or NULL if scan complete
 */
static TupleTableSlot *blockchain_scan_getnextslot(TableScanDesc scan,
                                                  ScanDirection direction,
                                                  TupleTableSlot *slot);

/**
 * End a blockchain table scan
 * 
 * @param scan The table scan descriptor to end
 */
static void blockchain_scan_end(TableScanDesc scan);

/**
 * Restart a blockchain table scan
 * 
 * @param scan The table scan descriptor
 * @param key New scan keys (can be NULL)
 * @param set_params Whether to set new parameters
 * @param allow_strat Whether to allow strategy changes
 * @param allow_sync Whether to allow sync changes
 * @param allow_pagemode Whether to allow page mode changes
 */
static void blockchain_scan_rescan(TableScanDesc scan, ScanKey key,
                                  bool set_params, bool allow_strat,
                                  bool allow_sync, bool allow_pagemode);
{code}
{expand}

### Relation Management

{expand:title=Relation Utility Functions}
{code:c|title=Relation Operations}
/**
 * Get the size of a blockchain table in pages
 * 
 * @param relation The blockchain table relation
 * @param forkNumber Fork number (usually MAIN_FORKNUM)
 * @return Size in pages
 */
static uint64 blockchain_relation_size(Relation relation, ForkNumber forkNumber);

/**
 * Determine if a blockchain table needs a TOAST table
 * 
 * @param relation The blockchain table relation
 * @return true if TOAST table is needed, false otherwise
 */
static bool blockchain_relation_needs_toast_table(Relation relation);

/**
 * Estimate relation size for query planning
 * 
 * @param relation The blockchain table relation
 * @param attr_widths Array of attribute widths
 * @param pages Estimated number of pages (output)
 * @param tuples Estimated number of tuples (output)
 * @param allvisfrac Fraction of all-visible pages (output)
 */
static void blockchain_estimate_rel_size(Relation relation, int32 *attr_widths,
                                        BlockNumber *pages, double *tuples,
                                        double *allvisfrac);
{code}
